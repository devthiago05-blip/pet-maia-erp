# Supabase — use a dedicated test project or local Supabase for the sandbox.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# NFC-e sandbox. Safe defaults are test + mock.
NFCE_ENABLED=false
NFCE_ENV=mock
NFCE_PROVIDER=mock
NFCE_CERT_MODE=mock
NFCE_CERT_PATH=
NFCE_CERT_PASSWORD=
NFCE_CNPJ=
NFCE_IE=
NFCE_CSC_ID=
NFCE_CSC_TOKEN=
NFCE_UF=CE
NFCE_SERIE=1
NFCE_INITIAL_NUMBER=1
NFCE_MUNICIPAL_CODE=
NFCE_TAX_REGIME=

# Dedicated 32+ character encryption secret. Required before production.
FISCAL_SECRETS_KEY=

# Integrated payments. Disabled keeps the current checkout unchanged.
PAYMENT_INTEGRATION_ENABLED=false
PAYMENT_PROVIDER=mock
PAYMENT_MOCK_SCENARIO=approved
MERCADO_PAGO_ACCESS_TOKEN=
STONE_API_TOKEN=
TEF_API_TOKEN=
